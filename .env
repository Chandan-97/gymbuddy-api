# Application Settings
APP_NAME="GymBuddy Sync API"
DEBUG=True
API_V1_STR="/api/v1"

# Security
# Run `openssl rand -hex 32` in your terminal to generate a secure secret key
JWT_SECRET_KEY="your-super-secret-random-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL="sqlite+aiosqlite:///./gymbuddy.db"
